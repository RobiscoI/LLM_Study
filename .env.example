# 이 파일을 .env 로 복사해서 값을 채운다.  .env 는 gitignore 대상이라
# git 으로 오가지 않는다 — PC 마다 한 번씩 만들어야 한다.
#
#   cp .env.example .env        (Git Bash)
#   copy .env.example .env      (cmd)
#
# 값은 절대 커밋하지 않는다. resolve.ps1 은 키 '이름'만 확인하고 값은 읽지 않는다.

# ── 필수 ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── 선택 ─────────────────────────────────────────────────────────────────────
# 다른 모델 제공자와 비교 실습을 할 때만
OPENAI_API_KEY=

# 웹 검색 도구를 붙이는 실습에서
TAVILY_API_KEY=

# Notion 로드맵 동기화 (tools/notion/sync_status.py)
# notion.so/my-integrations 에서 내부 인테그레이션 생성 -> Internal Integration Secret.
# 토큰만으로는 안 되고, 로드맵 페이지에서 '연결(Connections)' 에 그 인테그레이션을
# 추가해야 접근된다. ntn_ 또는 secret_ 으로 시작한다.
NOTION_API_KEY=

# 트레이싱/평가를 붙일 때
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=LLM_Study
